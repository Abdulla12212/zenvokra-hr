# Copy to .env before running `make up`. Every value here is a local-development
# default and safe to commit; real secrets belong in your deployment platform.
#
# Production (Render + Neon) uses DATABASE_URL, not these Compose variables.
# See docs/DEPLOY-RENDER.md.

# ---------- PostgreSQL ----------
POSTGRES_USER=zenvokra
POSTGRES_PASSWORD=zenvokra_dev_password
POSTGRES_DB=zenvokra_hr
POSTGRES_PORT=5432

# ---------- Backend ----------
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Development

# Applies pending EF Core migrations and seeds the platform admin on startup.
# Never enable this in production: run migrations as a separate deploy step.
DATABASE__MIGRATEONSTARTUP=true
DATABASE__SEEDONSTARTUP=true

# Seeded platform-admin login. Not a VITE_ variable — that would bake it into
# the public JavaScript bundle.
PLATFORMADMIN__EMAIL=owner@zenvokra.test
PLATFORMADMIN__PASSWORD=zenvokra-dev

# ---------- Frontend ----------
WEB_PORT=5173
# Empty means "use the Vite dev proxy at /api". Set an absolute URL to point the
# browser directly at a deployed API.
VITE_API_BASE_URL=
