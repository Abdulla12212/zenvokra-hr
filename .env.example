# Copy to .env before running `make up`. Every value here is a local-development
# default and safe to commit; real secrets belong in your deployment platform.

# ---------- PostgreSQL ----------
POSTGRES_USER=cloudesh
POSTGRES_PASSWORD=cloudesh_dev_password
POSTGRES_DB=cloudesh_hr
POSTGRES_PORT=5432

# ---------- pgAdmin ----------
PGADMIN_EMAIL=dev@cloudesh.local
PGADMIN_PASSWORD=cloudesh_dev_password
PGADMIN_PORT=5050

# ---------- Backend ----------
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Development

# Applies pending EF Core migrations and seeds demo data on startup.
# Never enable this in production: run migrations as a separate deploy step.
DATABASE__MIGRATEONSTARTUP=true
DATABASE__SEEDONSTARTUP=true

# ---------- Tenancy ----------
# Until authentication lands, the tenant is resolved from the X-Tenant-Id header
# and falls back to this value in Development. See docs/ARCHITECTURE.md.
TENANCY__DEFAULTTENANTID=00000000-0000-0000-0000-000000000001

# ---------- Frontend ----------
WEB_PORT=5173
# Empty means "use the Vite dev proxy at /api". Set an absolute URL to point the
# browser directly at a deployed API.
VITE_API_BASE_URL=
VITE_DEV_TENANT_ID=00000000-0000-0000-0000-000000000001
